NODE_ENV=development
PORT=5000

# MongoDB (Ixtiyoriy: ulanmasa avtomatik in-memory mock rejimiga o'tadi)
MONGO_URL=mongodb://127.0.0.1:27017/smartlab

# JWT Sozlamalari
JWT_ACCESS_SECRET=smartlab_jwt_access_secret_key_2026_dev
JWT_REFRESH_SECRET=smartlab_jwt_refresh_secret_key_2026_dev
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Cookie
COOKIE_SECRET=smartlab_cookie_secret_key_2026_dev
COOKIE_DOMAIN=localhost

# CORS Frontend Manzili
CLIENT_URL=http://localhost:5173

# OpenAI (Mira AI - bo'lmasa aqlli mahalliy fallback ishlaydi)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Gemini (Kimyoviy reaksiya va Registon audio-gid - bo'lmasa mahalliy fallback ishlaydi)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
